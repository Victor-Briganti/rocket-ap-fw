{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RISCV_ARCH": "rv32imac_zicsr",
        "RISCV_ABI": "ilp32",
        "RISCV_CMODEL": "medany"
      }
    },
    {
      "name": "gcc",
      "displayName": "RISC-V GCC",
      "description": "Build using the GNU RISC-V toolchain",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/gcc-toolchain.cmake"
    },
    {
      "name": "llvm",
      "displayName": "RISC-V LLVM/Clang",
      "description": "Build using LLVM/Clang with GCC sysroot",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/llvm-toolchain.cmake"
    }
  ],
  "buildPresets": [
    {
      "name": "gcc-toolchain",
      "displayName": "GCC Toolchain",
      "configurePreset": "gcc"
    },
    {
      "name": "llvm-toolchain",
      "displayName": "LLVM Toolchain",
      "configurePreset": "llvm"
    }
  ]
}

